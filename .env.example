# Copy to .env.local for local development.
# Base URL of the Spring Boot API (server.port 8080 + context-path /v1).
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Google Sign-In Web client id (Google Cloud Console → Credentials). Leave empty to hide the Google
# button. NEXT_PUBLIC_* is inlined at BUILD time, so set it before `next build` for production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
