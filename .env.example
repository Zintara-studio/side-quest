# SideQuests Arena — backend environment variables.
# Copy to `.env` and fill in for your environment, or (more commonly) set these in the process
# environment / your container orchestrator. Spring reads them via the ${VAR:default} placeholders in
# src/main/resources/application.yml. Values shown after "=" are the built-in defaults.

# ----- Profile -----------------------------------------------------------------
# `dev` (default): in-memory H2, schema auto-created, demo data seeded.
# `postgres`: PostgreSQL, schema validated/updated, no seeding unless SIDEQUEST_SEED_ENABLED=true.
SPRING_PROFILES_ACTIVE=dev

# ----- JWT (auth) --------------------------------------------------------------
# REQUIRED in production (the `postgres` profile has NO fallback — the app fails fast at startup if
# unset). Use a long, random secret (≥ 32 chars). The dev profile ships a committed dev-only default.
SIDEQUEST_JWT_SECRET=change-me-in-prod-this-is-a-very-long-dev-only-secret-key-0123456789
SIDEQUEST_ACCESS_TTL=3600            # access-token TTL, seconds (1 hour)
SIDEQUEST_REFRESH_TTL=2592000        # refresh-token TTL, seconds (30 days, rotated on refresh)

# ----- CORS --------------------------------------------------------------------
# Comma-separated allowed origins for the browser app. A wildcard disables credentialed CORS.
SIDEQUEST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Email / SMTP (dev-optional, REQUIRED in production) -----------------------
# Leave SMTP_HOST empty to log OTPs to the console (dev profile ONLY — any other profile fails fast at
# startup without it, so OTPs can never silently dump to stdout in prod). Set all four to send real
# mail (e.g. Gmail with an app password). The SMTP health probe is disabled, so an outage won't fail
# /actuator/health.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SIDEQUEST_MAIL_FROM=no-reply@sidequest.gg

# ----- Google Sign-In (optional) -----------------------------------------------
# Web OAuth client id used to verify Google id_tokens server-side. Empty → /auth/google returns a clean
# "not configured" error and the frontend hides the Google button. Must match the frontend
# NEXT_PUBLIC_GOOGLE_CLIENT_ID.
SIDEQUEST_GOOGLE_CLIENT_ID=

# ----- PostgreSQL (only used under SPRING_PROFILES_ACTIVE=postgres) -------------
# Against RDS, append ?sslmode=require so the JDBC connection is TLS (unless the parameter group
# already forces rds.force_ssl).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sidequest
SPRING_DATASOURCE_USERNAME=sidequest
SPRING_DATASOURCE_PASSWORD=sidequest
# Connection pool size — keep (instances × DB_POOL_SIZE) well under the RDS max_connections.
DB_POOL_SIZE=10
# Seed demo data on the postgres profile (default false). Never enable against a real database.
SIDEQUEST_SEED_ENABLED=false
